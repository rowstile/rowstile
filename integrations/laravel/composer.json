{
    "name": "rowstile/conformance-laravel",
    "description": "The PHP SDK's conformance suite: a small Laravel app on a rowstile policy (integrations/README.md)",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "rowstile/rowstile": "dev-checkout"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "larastan/larastan": "^3.7",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {"type": "path", "url": "../../sdk/php", "options": {"versions": {"rowstile/rowstile": "dev-checkout"}}}
    ],
    "autoload": {
        "psr-4": {"App\\": "app/"},
        "files": ["database/authz.php"]
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"php-http/discovery": false}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
