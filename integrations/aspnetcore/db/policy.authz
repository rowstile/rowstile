-- The conformance app's policy: projects with an owner and members, public ones anyone may read, a service
-- that reads the projects it is added to, notes in projects, an inbox only its recipient reads, and folders inside
-- folders, which their owner and the owners of the folders above edit.

app role conf_app

type user = app.users

type service = app.services principal

type project = app.projects
  owner   : user    = owner_id
  member  : user    = app.members(project_id -> user_id)
  service : service = app.project_services(project_id -> service_id)

  can edit = owner or member
  can view = edit or service or {public}

type note = app.notes
  project : project = project_id
  author  : user    = author_id

  can edit = author or project.owner
  can view = project.view

type message = app.inbox
  recipient : user = recipient_id

  can read = recipient

type folder = app.folders
  parent : folder = parent_id
  owner  : user   = owner_id

  can edit = owner or parent.edit

rules app.projects
  select : view

rules app.notes
  select : view
  insert : project.edit and author
  update : edit
  delete : edit

rules app.inbox
  select : read
  insert : signed_in and {sender_id = authz.uid()}

rules app.folders
  select : edit
  update : edit
