<?xml version="1.0" encoding="utf-8"?>
<!-- The SDK's packages come from the folder test.sh packs them into, never from nuget.org: the checks run this
     checkout's SDK. Everything else comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="this-checkout" value=".feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="this-checkout">
      <package pattern="Rowstile" />
      <package pattern="Rowstile.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
