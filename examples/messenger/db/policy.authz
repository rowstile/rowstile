-- policy.authz: every access rule of the messenger. It reaches the database as the migrations rowstile
-- migrate writes into db/migrations; the backend has no permission checks of its own. Read it top to
-- bottom: people, bots, chats, then what each table allows.

app role ms_app

type user = ms.users (id uuid)
  self        : user = id                                   -- your own row
  has_blocked : user = ms.blocks(blocker_id -> blocked_id)  -- the people this person blocked
  can edit = self  -- your own profile

-- bots are services: they sign in with their own API keys (made by their owner) and post as themselves
type bot = ms.bots principal where {active}
  owner : user = owner_id
  can manage      = owner
  can manage_keys = owner

type chat = ms.chats
  member  : user = ms.members(chat_id -> user_id)
  admin   : user = ms.members(chat_id -> user_id) where {role in ('admin', 'owner')}
  owner   : user = ms.members(chat_id -> user_id) where {role = 'owner'}
  creator : user = created_by
  bot     : bot  = ms.chat_bots(chat_id -> bot_id)
  blocked : user = ms.direct_blocks(chat_id -> user_id)  -- a direct chat where one blocked the other
  invitee : link shared by invite                        -- invite links: anyone holding one

  can read = member or bot
  -- members post, unless blocked in a direct chat, or the group is for announcements and they aren't an admin
  can post   = (member and not blocked and ({not admins_only} or admin)) or bot
  can manage = admin and {kind = 'group'}                -- the title, the members, bots, invite links
  can invite = manage
  can join   = (invitee and {kind = 'group'}) or manage  -- (admins may make links, so they hold what links give)
  -- a chat just created, before anyone is in it: its creator sees it and adds themselves
  can setup = creator and {not exists (select 1 from ms.members m where m.chat_id = this.id)}
  -- adding people: admins of a group; the one who starts a direct chat adds the other person
  can add_members = manage or setup
                 or (creator and {kind = 'direct'} and {(select count(*) from ms.members m where m.chat_id = this.id) < 2})

-- a membership row: a person in a chat. Its key is (chat_id, user_id)
type membership = ms.members (chat_id, user_id uuid)
  chat   : chat = chat_id
  person : user = user_id

-- messages are numbered per chat; members read what was said since they joined, bots the whole chat
type message = ms.messages (chat_id, seq)
  chat     : chat = chat_id
  sender   : user = sender_id
  from_bot : bot  = bot_id

  can read   = chat.read and {seq > coalesce(ms.joined_seq(chat_id), 0)}  -- (by number, not by the clock)
  can edit   = sender and {not deleted and created_at > now() - interval '15 minutes'}
  can remove = sender or chat.manage                                      -- delete for everyone

type chat_bot = ms.chat_bots (chat_id, bot_id)
  chat : chat = chat_id
  bot  : bot  = bot_id

type block = ms.blocks (blocker_id uuid, blocked_id uuid)
  blocker : user = blocker_id

rules ms.users
  select                       : signed_in  -- to find people by phone number
  update                       : edit
  update id, phone, created_at : nobody

rules ms.bots
  select              : signed_in
  insert              : owner
  update              : manage
  update id, owner_id : nobody
  delete              : manage
  -- an account is deleted by the tables' owner (no rule lets the app): its bots go with it
  cascade from ms.users

rules ms.chats
  select                                        : read or join or setup
  insert                                        : creator
  update                                        : manage
  update kind, created_by, created_at, last_seq : nobody
  delete                                        : owner and {kind = 'group'}
  -- a chat outlives the account that made it
  cascade from ms.users

rules ms.members
  -- added by someone who may (not as an admin unless they are one; as the owner only when the chat is set
  -- up), never someone who blocked you;
  -- or yourself, with an invite link
  insert                                         : (chat.add_members and ({role = 'member'} or chat.setup
                                                or (chat.manage and {role <> 'owner'}))
                                               and not person.has_blocked)
                                                or (chat.join and person and {role = 'member'})
  select                                         : chat.read
  update                                         : chat.manage or person
  update role                                    : chat.manage and {role <> 'owner'}              -- nobody demotes the owner
  update role after                              : {role <> 'owner'}                              -- nor makes another
  update last_read_seq                           : person
  update chat_id, user_id, joined_at, joined_seq : nobody
  delete                                         : (person or chat.manage) and {role <> 'owner'}  -- leave, or be removed; never the owner
  -- a group deleted by its owner takes every membership in it; an account deleted, its memberships
  cascade from ms.chats
  cascade from ms.users

rules ms.messages
  select                                             : read
  insert                                             : chat.post and ((sender and {bot_id is null}) or (from_bot and {sender_id is null}))
  update                                             : edit or remove
  update body after                                  : (edit and {not deleted}) or {deleted and body = ''}
  update deleted                                     : remove
  update deleted after                               : {deleted}  -- no undelete
  update edited_at                                   : edit       -- marked edited only while it may be edited
  update chat_id, seq, sender_id, bot_id, created_at : nobody
  delete                                             : nobody     -- messages are deleted for everyone, not removed
  -- a group deleted by its owner takes its messages, which no rule removes; a deleted account's or bot's
  -- messages stay, from nobody
  cascade from ms.chats
  cascade from ms.users
  cascade from ms.bots

rules ms.chat_bots
  select : chat.read
  insert : chat.manage and bot.manage and {added_by = authz.uid()}  -- your own bots, into chats you manage
  delete : chat.manage or bot.manage
  -- a deleted chat or bot takes the bot out of the chat; a deleted account leaves the bots it added
  cascade from ms.chats
  cascade from ms.bots
  cascade from ms.users

rules ms.blocks
  select : blocker
  insert : blocker
  delete : blocker
  -- an account deleted, the blocks it made and those made against it
  cascade from ms.users (blocker_id)
  cascade from ms.users (blocked_id)
