-- policy.authz: who can do what in the file manager. rowstile migrate writes it as migrations.
-- Folders nest; what you may do in a folder you may do in everything inside it, unless a folder
-- stops inheritance (inherit = false). People share folders and files with users and groups.

app role fm_app

type user = fm.users (id uuid)

type group = fm.groups (id uuid)
  member : user         = fm.group_members(group_id -> user_id)
  member : group#member = fm.groups(parent_id -> id)  -- members of sub-groups count too
  owner  : user         = owner_id
  admin  : user         = fm.group_members(group_id -> user_id) where {is_admin}
  parent : group        = parent_id

  -- who may rename it, add and remove members and sub-groups: its owner, its admins, and those of the groups above
  can manage = owner or admin or parent.manage

type membership = fm.group_members
  group  : group = group_id
  person : user  = user_id

  can manage = group.manage

type folder = fm.folders
  parent : folder = parent_id
  owner  : user   = owner_id
  viewer : user, group#member, link shared by share
  editor : user, group#member shared by share

  can share = owner or (parent.share and {inherit})
  can edit  = share or editor or (parent.edit and {inherit})
  can view  = edit or viewer or (parent.view and {inherit})
  -- support staff may give themselves access for a short time: audited, announced (authz.break_glass)
  can break_glass = {exists (select 1 from fm.users u where u.id = authz.uid() and u.is_support)}

type file = fm.files
  folder : folder = folder_id
  owner  : user   = owner_id
  viewer : user, group#member, link shared by share
  editor : user, group#member shared by share

  can share = owner or folder.share
  can edit  = share or editor or folder.edit
  can view  = edit or viewer or folder.view

-- every stored object is a version of a file, with the file's permissions
type version = fm.file_versions
  file : file = file_id

  can view = file.view
  can edit = file.edit

rules fm.folders
  select                       : view
  insert                       : ({parent_id is null} or parent.edit) and owner
  update                       : edit
  update parent_id after       : parent.edit or ({parent_id is null} and share)
  update parent_id             : share  -- moving it takes it from everyone above, as deleting it does
  update id, owner_id, inherit : share
  delete                       : share

rules fm.files
  select                 : view
  insert                 : folder.edit and owner and {fm.key_is_new(object_key)}
  update                 : edit
  update folder_id after : folder.edit
  update id, owner_id    : share
  -- a file shows one of its own versions, never another file's object
  update object_key after : {object_key IN (SELECT v.object_key FROM fm.file_versions v WHERE v.file_id = files.id AND v.ready)}
  delete                  : edit

rules fm.file_versions
  select                                     : view
  insert                                     : file.edit and {created_by = authz.uid()}
  update                                     : edit
  update id, file_id, object_key, created_by : nobody  -- what a version is never changes
  delete                                     : edit

-- everyone signed in sees the groups and who is in them (to share with them)
rules fm.groups
  select                 : signed_in
  insert                 : owner and ({parent_id is null} or parent.manage)
  update                 : manage
  update parent_id after : {parent_id is null} or parent.manage
  update id, owner_id    : manage
  delete                 : manage

rules fm.group_members
  select                : signed_in
  insert                : manage
  update                : manage
  update group_id after : manage
  update id, user_id    : nobody            -- a membership's person never changes
  delete                : manage or person  -- anyone may leave a group
  -- an account is deleted by the tables' owner (no rule lets the app), and its memberships go with it
  cascade from fm.users
