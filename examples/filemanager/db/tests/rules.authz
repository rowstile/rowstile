-- The file manager's rules, tested with their own data (rolled back after each test).
-- Run: rowstile test (from filemanager/), or rowstile dev while editing the policy.

test "a folder's owner has everything inside it, and turning inheritance off stops it"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given bo = {INSERT INTO fm.users (email, name) VALUES ('t-bo@x', 'Bo') RETURNING id}
  given top = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Top') RETURNING id}
  given sub = {INSERT INTO fm.folders (parent_id, owner_id, name) VALUES ($top, $bo, 'Sub') RETURNING id}
  given own = {INSERT INTO fm.folders (parent_id, owner_id, name, inherit) VALUES ($top, $bo, 'Own', false) RETURNING id}
  given f = {INSERT INTO fm.files (folder_id, owner_id, name) VALUES ($sub, $bo, 'plan.txt') RETURNING id}
  user $ann can share file $f
  user $ann can edit folder $sub
  user $ann cannot view folder $own
  user $bo cannot view folder $top
  as user $bo sees 0 {SELECT FROM fm.folders WHERE id = $top}
  as user $bo refused {INSERT INTO fm.folders (parent_id, owner_id, name) VALUES ($top, $bo, 'Mine')}
  as user $ann allowed {INSERT INTO fm.folders (parent_id, owner_id, name) VALUES ($sub, $ann, 'Notes')}

test "sharing with a group reaches its sub-groups' members"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given bo = {INSERT INTO fm.users (email, name) VALUES ('t-bo@x', 'Bo') RETURNING id}
  given cy = {INSERT INTO fm.users (email, name) VALUES ('t-cy@x', 'Cy') RETURNING id}
  given eng = {INSERT INTO fm.groups (name, owner_id) VALUES ('Engineering', $ann) RETURNING id}
  given web = {INSERT INTO fm.groups (name, parent_id, owner_id) VALUES ('Web', $eng, $ann) RETURNING id}
  given {INSERT INTO fm.group_members (group_id, user_id) VALUES ($web, $bo)}
  given docs = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Docs') RETURNING id}
  user $bo cannot view folder $docs
  as user $ann allowed {SELECT authz.share('folder', $docs, 'viewer', 'group', $eng, 'member')}
  user $bo can view folder $docs
  user $bo cannot edit folder $docs
  user $cy cannot view folder $docs
  as user $bo refused {SELECT authz.share('folder', $docs, 'viewer', 'user', $cy)}

test "groups: their owner, admins and those above manage them; anyone may leave"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given bo = {INSERT INTO fm.users (email, name) VALUES ('t-bo@x', 'Bo') RETURNING id}
  given cy = {INSERT INTO fm.users (email, name) VALUES ('t-cy@x', 'Cy') RETURNING id}
  given eng = {INSERT INTO fm.groups (name, owner_id) VALUES ('Engineering', $ann) RETURNING id}
  given web = {INSERT INTO fm.groups (name, parent_id, owner_id) VALUES ('Web', $eng, $bo) RETURNING id}
  given {INSERT INTO fm.group_members (group_id, user_id, is_admin) VALUES ($web, $cy, false)}
  user $ann can manage group $web
  user $bo can manage group $web
  user $cy cannot manage group $web
  as user $cy refused {UPDATE fm.groups SET name = 'Mine' WHERE id = $web}
  as user $cy allowed {DELETE FROM fm.group_members WHERE group_id = $web AND user_id = $cy}

test "a file shows one of its own versions, never another file's"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given docs = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Docs') RETURNING id}
  given a = {INSERT INTO fm.files (folder_id, owner_id, name) VALUES ($docs, $ann, 'a.txt') RETURNING id}
  given b = {INSERT INTO fm.files (folder_id, owner_id, name) VALUES ($docs, $ann, 'b.txt') RETURNING id}
  given mine = {INSERT INTO fm.file_versions (file_id, created_by, ready) VALUES ($a, $ann, true) RETURNING object_key}
  given other = {INSERT INTO fm.file_versions (file_id, created_by, ready) VALUES ($b, $ann, true) RETURNING object_key}
  as user $ann allowed {UPDATE fm.files SET object_key = $mine WHERE id = $a}
  as user $ann refused {UPDATE fm.files SET object_key = $other WHERE id = $a}

test "support staff may break the glass, nobody else"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given sue = {INSERT INTO fm.users (email, name, is_support) VALUES ('t-sue@x', 'Sue', true) RETURNING id}
  given docs = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Docs') RETURNING id}
  user $sue can break_glass folder $docs
  user $sue cannot view folder $docs
  user $ann can view folder $docs

test "moving a folder needs share, as deleting it does; an editor may still rename it"
  given ann = {INSERT INTO fm.users (email, name) VALUES ('t-ann@x', 'Ann') RETURNING id}
  given bo = {INSERT INTO fm.users (email, name) VALUES ('t-bo@x', 'Bo') RETURNING id}
  given top = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Top') RETURNING id}
  given sub = {INSERT INTO fm.folders (parent_id, owner_id, name) VALUES ($top, $ann, 'Sub') RETURNING id}
  given other = {INSERT INTO fm.folders (owner_id, name) VALUES ($ann, 'Other') RETURNING id}
  given mine = {INSERT INTO fm.folders (owner_id, name) VALUES ($bo, 'Mine') RETURNING id}
  as user $ann allowed {SELECT authz.share('folder', $top, 'editor', 'user', $bo)}
  user $bo can edit folder $sub
  user $bo cannot share folder $sub
  as user $bo refused {UPDATE fm.folders SET parent_id = $mine WHERE id = $sub}
  as user $bo refused {UPDATE fm.folders SET parent_id = NULL WHERE id = $sub}
  as user $bo allowed {UPDATE fm.folders SET name = 'Renamed' WHERE id = $sub}
  as user $ann allowed {UPDATE fm.folders SET parent_id = $other WHERE id = $sub}
