-- answer: conditions-rights
-- Conditions read with the policy's rights: a subquery sees every row of the tables it reads, in a rule, a
-- permission, authz.can, and another type's rule through rel.perm.
app role app_user

type user = app.users
type project = app.projects
  member : user = app.memberships(project_id -> user_id)
  can view = member
  can has_files = {exists (select 1 from app.files f where f.project_id = this.id)}
type file = app.files
  project : project = project_id
  can view = {exists (select 1 from app.projects p where p.id = this.project_id and p.public)}

rules app.projects
  select : view
rules app.files
  select : view or project.has_files

test "a subquery sees rows the user may not"
  given ann = {INSERT INTO app.users (id) VALUES (1) RETURNING id}
  given p   = {INSERT INTO app.projects (id, public) VALUES (1, true) RETURNING id}
  given q   = {INSERT INTO app.projects (id, public) VALUES (2, false) RETURNING id}
  given f   = {INSERT INTO app.files (project_id) VALUES ($p) RETURNING id}
  given g   = {INSERT INTO app.files (project_id) VALUES ($q) RETURNING id}
  as user $ann sees 0 {SELECT FROM app.projects WHERE id = $p}
  as user $ann sees 1 {SELECT FROM app.files WHERE id = $f}
  user $ann can view file $f
  as user $ann sees 1 {SELECT FROM app.files WHERE id = $g}
