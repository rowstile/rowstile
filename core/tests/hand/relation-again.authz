-- answer: relation-again, inheritance
-- A relation declared again adds a source, of another type too: a doc's parent is a doc (by its column up, or a
-- link table) or its project, and view inherits through each. Doc 2 is locked, so its owner doesn't view it, nor
-- what is below it; doc 3's parent is doc 1 by up; docs 5 and 7 are in project 1, whose owner is user 3.
app role app_user

type user = app.users
type project = app.projects
  owner : user = owner_id
  can view = owner
type doc = app.docs
  owner  : user = owner_id
  parent : doc = up
  parent : doc = app.doc_links(child -> parent)
  parent : project = project_id
  can share = owner or parent.owner
  can view  = (owner and not {locked}) or parent.view

rules app.docs
  select : view

test "a parent from three sources, of two types"
  given {INSERT INTO app.users (id) VALUES (1), (2), (3)}
  given {INSERT INTO app.projects (id, owner_id) VALUES (1, 3)}
  given {INSERT INTO app.docs (id, owner_id, locked, project_id) VALUES (1, 1, false, NULL), (2, 1, true, NULL), (4, NULL, false, NULL), (5, NULL, false, 1), (6, NULL, false, NULL), (7, 2, false, 1)}
  given {INSERT INTO app.docs (id, up) VALUES (3, 1)}
  given {INSERT INTO app.doc_links (child, parent) VALUES (4, 2), (6, 5)}
  user 1 can view doc 1
  user 1 cannot view doc 2
  user 1 can view doc 3
  user 1 cannot view doc 4
  user 1 cannot view doc 6
  as user 1 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'view') x ORDER BY x) = '{1,3}'}
  user 2 can view doc 7
  user 2 cannot view doc 5
  as user 2 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'view') x ORDER BY x) = '{7}'}
  user 3 can view doc 5
  user 3 can view doc 6
  user 3 can view doc 7
  user 3 cannot view doc 1
  as user 3 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'view') x ORDER BY x) = '{5,6,7}'}
  as user 3 sees 1 {SELECT WHERE ARRAY(SELECT id FROM app.docs ORDER BY id) = '{5,6,7}'}
  anyone cannot view doc 1
  as anyone sees 0 {SELECT FROM authz.list('doc', 'view')}
  user 1 can share doc 2
  user 1 can share doc 3
  user 1 can share doc 4
  user 1 cannot share doc 5
  as user 1 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'share') x ORDER BY x) = '{1,2,3,4}'}
  as user 3 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'share') x ORDER BY x) = '{5,7}'}
  given {DELETE FROM app.doc_links WHERE child = 6}
  given {INSERT INTO app.doc_links (child, parent) VALUES (6, 1)}
  user 1 can view doc 6
  user 3 cannot view doc 6
  as user 1 sees 1 {SELECT WHERE ARRAY(SELECT id FROM app.docs ORDER BY id) = '{1,3,6}'}
  as user 3 sees 1 {SELECT WHERE ARRAY(SELECT x FROM authz.list('doc', 'view') x ORDER BY x) = '{5,7}'}
