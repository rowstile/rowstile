-- answer: shares-gone
-- A share goes with its object: a project deleted takes its shares with it, so one made again with the same id
-- starts with none, even on a type whose only relation is shared.
app role app_user

type user = app.users
type project = app.projects
  viewer : user shared
  can share = nobody
  can view  = viewer

test "a deleted project's shares go with it"
  given bo = {INSERT INTO app.users (id) VALUES (2) RETURNING id}
  given p  = {INSERT INTO app.projects (id) VALUES (1) RETURNING id}
  given {INSERT INTO authz.shares (object_type, object_id, relation, subject_type, subject_id) VALUES ('project', '1', 'viewer', 'user', $bo::text)}
  user $bo can view project 1
  given {DELETE FROM app.projects WHERE id = 1}
  given {INSERT INTO app.projects (id) VALUES (1)}
  user $bo cannot view project 1
