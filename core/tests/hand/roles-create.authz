-- answer: roles-create, runtime-manage-roles
-- Creating a role needs manage_roles on its owner; the role is shared as role:<id>, by someone who holds share on
-- the object and everything the role grants.
app role app_user

type user = app.users
type org = app.orgs
  admin : user = app.org_admins(org_id -> user_id)
  can manage_roles = admin
type folder = app.folders
  org   : org = org_id
  owner : user = owner_id
  roles : user from org
  can share   = owner or org.admin
  can view    = owner or roles
  can edit    = owner or roles
  can archive = org.admin or roles

test "making a role and giving it"
  given alice = {INSERT INTO app.users (id) VALUES (1) RETURNING id}
  given bo    = {INSERT INTO app.users (id) VALUES (2) RETURNING id}
  given erin  = {INSERT INTO app.users (id) VALUES (5) RETURNING id}
  given o     = {INSERT INTO app.orgs (id) VALUES (1) RETURNING id}
  given {INSERT INTO app.org_admins VALUES ($o, $erin)}
  given f     = {INSERT INTO app.folders (org_id, owner_id) VALUES ($o, $alice) RETURNING id}
  as user $alice refused {SELECT authz.create_role('org', 1, 'folder', 'reviewer', ARRAY['view'])}
  as user $erin allowed {SELECT authz.create_role('org', 1, 'folder', 'reviewer', ARRAY['view'])}
  as user $erin allowed {SELECT authz.create_role('org', 1, 'folder', 'archivist', ARRAY['archive'])}
  given reviewer  = {SELECT id FROM authz.roles WHERE name = 'reviewer'}
  given archivist = {SELECT id FROM authz.roles WHERE name = 'archivist'}
  as user $alice allowed {SELECT authz.share('folder', $f, 'role:' || $reviewer, 'user', $bo)}
  user $bo can view folder $f
  user $bo cannot edit folder $f
  as user $alice refused {SELECT authz.share('folder', $f, 'role:' || $archivist, 'user', $bo)}
  as user $erin allowed {SELECT authz.share('folder', $f, 'role:' || $archivist, 'user', $bo)}
  user $bo can archive folder $f
