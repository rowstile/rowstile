-- answer: rows-no-rule
-- No rule allows anything on a row the type's where leaves out: the app role can't read, change or delete an
-- archived folder, so it can't un-archive one (nor archive one: the update rule holds after the change too).
app role app_user

type user = app.users
type folder = app.folders where {not archived}
  owner : user = owner_id

rules app.folders
  select : anyone
  update : owner
  delete : owner

test "an archived folder is out of every rule's reach"
  given ann = {INSERT INTO app.users (id) VALUES (1) RETURNING id}
  given a   = {INSERT INTO app.folders (owner_id, archived) VALUES ($ann, true) RETURNING id}
  given b   = {INSERT INTO app.folders (owner_id) VALUES ($ann) RETURNING id}
  as user $ann sees 0 {SELECT FROM app.folders WHERE id = $a}
  as user $ann sees 1 {SELECT FROM app.folders WHERE id = $b}
  as user $ann refused {UPDATE app.folders SET archived = false WHERE id = $a}
  as user $ann refused {DELETE FROM app.folders WHERE id = $a}
  as user $ann allowed {UPDATE app.folders SET name = 'b' WHERE id = $b}
  as user $ann refused {UPDATE app.folders SET archived = true WHERE id = $b}
