-- answer: conditions-this
-- In a subquery, this. names the object; a bare id is the subquery's table's own (here the membership's).
app role app_user

type user = app.users
type project = app.projects
  can view = {exists (select 1 from app.memberships m where m.project_id = this.id and m.user_id = authz.uid())}
  can bare = {exists (select 1 from app.memberships m where m.project_id = id and m.user_id = authz.uid())}

rules app.projects
  select : view

test "this and a bare column in a subquery"
  given ann  = {INSERT INTO app.users (id) VALUES (1) RETURNING id}
  given cy   = {INSERT INTO app.users (id) VALUES (3) RETURNING id}
  given p1   = {INSERT INTO app.projects (id) VALUES (1) RETURNING id}
  given p100 = {INSERT INTO app.projects (id) VALUES (100) RETURNING id}
  given {INSERT INTO app.memberships (id, project_id, user_id) VALUES (100, 1, 1), (1, 1, 3)}
  user $ann can view project $p1
  user $ann cannot view project $p100
  user $cy can view project $p1
  user $cy cannot view project $p100
  user $ann cannot bare project $p1
  user $ann cannot bare project $p100
  user $cy can bare project $p1
  user $cy can bare project $p100
  as user $ann sees 1 {SELECT FROM app.projects}
