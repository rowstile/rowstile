-- roles.authz: the types the policy language page's example (docs/reference/language.md) leaves to the file it
-- includes, so that the example compiles (tests/unit_test.py DocPages) and applies to the tables of language.sql
-- (tests/reference.sh)
type org = app.orgs
  member : user = app.org_members(org_id -> user_id)
  admin  : user = app.org_members(org_id -> user_id) where {role = 'admin'}
  can manage_roles = admin
type project = app.projects
  owner : user = owner_id
  can share = owner
  can edit = share
  can view = edit
type file = app.files
  folder : folder = folder_id
  owner : user = owner_id
  can share = owner or folder.share
  can edit = share or folder.edit
  can view = edit or folder.view
