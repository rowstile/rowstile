-- cross.authz: inheritance through two types at once (difftest --gen cross). Folders sit in folders or in
-- projects; a project sits in folders, placed there by a table of its own or by sharing. What a folder's editors
-- pass down stops at a frozen folder, which a condition reads from another table; an archived folder holds
-- nothing, and a placement that isn't active places nothing. What is filed comes down only to a folder nobody
-- owns: from the folder above, inside the recursion, or from the project the folder sits in, whose filing is its
-- lead's alone (outside it). A closed site, which the type's where reads from another table, holds nothing. A
-- region's chief is named by a column, or by sharing; a site's wardens are the chiefs of the region its column
-- names. Notes are written and never read back: no select rule, so explain tells even their authors nothing.
-- A project's backers are folders or regions, which a table's rows name with their type: what is funded comes
-- down from them, through the folders inside the recursion and through the regions outside it.
app role app_user

type user = cx.users

type folder = cx.folders where {not archived}
  parent : folder, project = (parent_type, parent_id)          -- inside a folder or a project
  owner  : user = owner_id
  viewer : user  shared by view
  can edit = owner or (parent.edit and {not exists (select 1 from cx.frozen "z""s" where "z""s".folder_id = this.id)})
  can view = edit or viewer or parent.view
  -- a comment, dollar quotes, an E'' string, a quote doubled in a string and in a name are text in a condition:
  -- this. stays as written there; and <>-1 is <> then a minus, as Postgres reads it
  can file = owner or (parent.file and {owner_id is null /* this.owner_id: nobody's */ and parent_type <> $$this.id$$ and parent_type <> e'it\'s' and parent_type <> 'this.id''s' and id <>-1})
  can fund = owner or parent.fund
  can tidy = owner and not parent.file                          -- a deny through the column's (type, id) pair

type project = cx.projects
  inside : folder = cx.placements(project_id -> folder_id) where {active}   -- placed in folders by a table
  host   : folder  shared by edit                                          -- or by sharing
  lead   : user = lead_id
  backer : folder, region = cx.backings(project_id -> (backer_type, backer_id))   -- a table naming either
  can edit = lead or inside.edit or host.edit
  can view = edit or inside.view or host.view
  can file = lead
  can fund = lead or backer.fund
  can judge = view and not backer.fund                          -- a deny through the table's (type, id) pair

type region = cx.regions                                                    -- regions and sites hold each other,
  over  : site   = cx.site_links(region_id -> site_id) where {active}        -- through tables only, and nothing
  over  : region = cx.region_links(region_id -> parent_id)                   -- but a link's where stops them
  chief : user   = chief_id
  chief : user   shared by run
  guest : user, link  shared by rename                                     -- whoever may share a region sees its
  can run = chief or over.run                                              -- links; only its chiefs turn them off
  can rename = chief
  can fund = chief
  can share = run
  can visit = guest or run

type site = cx.sites where {not exists (select 1 from cx.closed c where c.site_id = this.id)}
  over   : region = cx.site_regions(site_id -> region_id) where {active}
  warden : region#chief = region_id                                   -- a column naming a group's members
  can run = over.run
  can guard = warden or run

type note = cx.notes                                                -- written, never read back: no select rule
  author : user = author_id
  can write = author
  can open = {author_id is null} and {id > 0}                        -- conditions alone: anyone, on such a row

rules cx.notes
  insert : write

rules cx.folders
  select : view
  update : edit
  delete : file

rules cx.regions
  select : run
  update : rename

rules cx.sites view cx.sites_seen                                    -- the app reads sites through this view: no mask
  select : run
  update : guard

rules cx.projects
  select : view
  update : edit
  update after : edit
  delete : fund
