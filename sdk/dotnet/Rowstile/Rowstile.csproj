<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>rowstile for .NET apps on Npgsql (preview): transactions signed in as the request's user, and the database's refusals read into exceptions and problem bodies</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- what only the EF Core package calls: whom the transactions BeginSignedInAsync began signed in as
         (SignedConnections), the sign-in's statement, the question asked of a write that matched no row and its
         answer (Verdicts, Stale.Record), a key's text (Keys); and the conformance suite's tests of them
         (integrations/aspnetcore/Tests) -->
    <InternalsVisibleTo Include="Rowstile.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>
</Project>
