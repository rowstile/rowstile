{
  "name": "@rowstile/vitest",
  "version": "0.1.0-beta.1",
  "description": "rowstile with Vitest (and Jest): asUser, toBeRefused, a database per worker",
  "license": "Apache-2.0",
  "homepage": "https://rowstile.dev",
  "keywords": [
    "rowstile",
    "postgres",
    "postgresql",
    "authorization",
    "row-level-security",
    "rls",
    "permissions",
    "access-control",
    "rbac",
    "rebac",
    "multi-tenant",
    "vitest",
    "jest",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowstile/rowstile.git",
    "directory": "sdk/typescript/vitest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@rowstile/client": "0.1.0-beta.1"
  },
  "peerDependencies": {
    "pg": "^8.23.1",
    "vitest": "^4.1.11 || ^5.0.5"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
