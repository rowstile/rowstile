{
  // The site's scripts are plain JavaScript typed with JSDoc, and its VitePress config TypeScript, all checked
  // strictly (npm ci here, and at the repository's root for @types/node):   npx tsc -p site
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": true, "skipLibCheck": true,
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "noUnusedLocals": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["*.mjs", "assets/*.mjs", ".vitepress/config.mts"]
}
