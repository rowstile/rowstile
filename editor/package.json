{
  "name": "rowstile",
  "displayName": "rowstile policy language",
  "description": "For .authz policy files: highlighting (with SQL inside { }), errors while typing, hover, go to definition, references, outline and completion, from the rowstile language server.",
  "version": "0.1.3",
  "publisher": "rowstile",
  "license": "Apache-2.0",
  "homepage": "https://rowstile.dev/editor",
  "icon": "icon.png",
  "galleryBanner": { "color": "#14213d", "theme": "dark" },
  "keywords": ["rowstile", "authz", "postgres", "row-level-security", "authorization"],
  "repository": { "type": "git", "url": "git+https://github.com/rowstile/rowstile.git", "directory": "editor" },
  "files": ["extension.js", "language-configuration.json", "syntaxes", "icon.png", "README.md", "LICENSE", "node_modules"],
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:authz"],
  "contributes": {
    "languages": [{
      "id": "authz",
      "aliases": ["authz policy", "authz"],
      "extensions": [".authz"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "authz",
      "scopeName": "source.authz",
      "path": "./syntaxes/authz.tmLanguage.json",
      "embeddedLanguages": { "meta.embedded.sql.authz": "sql" }
    }],
    "configuration": {
      "title": "rowstile",
      "properties": {
        "rowstile.command": {
          "type": "array", "items": { "type": "string" },
          "default": ["rowstile", "lsp"],
          "description": "How to start the language server. A path is from the workspace folder. For rowstile installed in the project: [\"npx\", \"--no\", \"rowstile\", \"lsp\"] (npm) or [\".venv/bin/rowstile\", \"lsp\"] (pip, uv); from a checkout: [\"python3\", \"/path/to/rowstile/core/cli/rowstile_cli.py\", \"lsp\"]."
        }
      }
    }
  },
  "scripts": { "package": "npx --yes @vscode/vsce@3.9.2 package" },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": { "@types/vscode": "~1.82.0", "vscode-oniguruma": "2.0.1", "vscode-textmate": "9.3.2" }
}
