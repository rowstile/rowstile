{
  "comments": { "lineComment": "--" },
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["[", "]"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^(type|rules|test|invariants)\\b.*$",
    "decreaseIndentPattern": "^\\s*(type|rules|test|invariants|app|scope|caveat|include)\\b"
  }
}
