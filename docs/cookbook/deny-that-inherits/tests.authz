-- A deny that inherits (docs/cookbook/deny-that-inherits.md). The test brings its own rows and rolls them back.

test "a hidden page hides everything below it"
  given ann = {INSERT INTO app.users VALUES (901, 'Ann') RETURNING id}
  given bo = {INSERT INTO app.users VALUES (902, 'Bo') RETURNING id}
  given top = {INSERT INTO app.pages (title) VALUES ('Handbook') RETURNING id}
  given mid = {INSERT INTO app.pages (parent_id, title, hidden) VALUES ($top, 'Drafts', true) RETURNING id}
  given low = {INSERT INTO app.pages (parent_id, title) VALUES ($mid, 'A draft') RETURNING id}
  given side = {INSERT INTO app.pages (parent_id, title) VALUES ($top, 'Holidays') RETURNING id}
  given {INSERT INTO app.page_readers VALUES ($top, $ann), ($low, $ann)}
  user $ann can read page $top
  user $ann can read page $side
  user $ann cannot read page $mid
  user $ann cannot read page $low
  user $bo cannot read page $top
  as user $ann sees 2 {SELECT FROM app.pages WHERE id IN ($top, $mid, $low, $side)}
  as user $ann sees 0 {SELECT WHERE authz.can('page', $mid, 'hidden')}
  as user $bo sees 0 {SELECT FROM authz.list('page', 'hidden')}
